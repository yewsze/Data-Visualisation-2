{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 600,
  "title": {
    "text": "Most Visited Parks and Reserves in the Northern Territory, 2024-25",
    "subtitle": "NT Government-managed parks only. Excludes Commonwealth-managed Kakadu and Uluru-Kata Tjuta.",
    "font": "Vanio, serif",
    "subtitleFont": "Vanio, serif",
    "fontSize": 18,
    "subtitleFontSize": 14,
    "fontWeight": "bold"
  },
  "background": "#f4f7f9",
  "params": [
    {
      "name": "zoom_level",
      "value": 2000,
      "bind": {"input": "range", "min": 2000, "max": 60000, "step": 100, "name": "Zoom: "}
    },
    {
      "name": "focus",
      "value": "Whole NT",
      "bind": {"input": "select", "options": ["Whole NT", "Darwin", "Katherine", "Alice Springs"], "name": "Focus: "}
    }
  ],
  "projection": {
    "type": "mercator",
    "scale": {"expr": "zoom_level"},
    "center": {"expr": "focus == 'Darwin' ? [130.95, -12.7] : focus == 'Katherine' ? [132.5, -14.5] : focus == 'Alice Springs' ? [133, -24] : [133, -19]"}
  },
  "layer": [
    {
      "data": {
        "url": "https://yewsze.github.io/Data-Visualisation-2/clone-data/spatial_data/commonwealth/topojson/simplified/STE_2021_AUST_GDA94.json",
        "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA94"}
      },
      "transform": [{"filter": "datum.properties.STE_NAME21 != 'Northern Territory'"}],
      "mark": {"type": "geoshape", "fill": "#e3e6e1", "stroke": "#cfd4cc", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "https://yewsze.github.io/Data-Visualisation-2/clone-data/spatial_data/states/nt/topojson/simplified/LGA_2023_NT_GDA2020.json",
        "format": {"type": "topojson", "feature": "LGA_2023_AUST_GDA2020"}
      },
      "transform": [
        {
          "lookup": "properties.LGA_NAME23",
          "from": {
            "data": {"values": [
              {"lga": "Darwin", "region": "Darwin"},
              {"lga": "Palmerston", "region": "Darwin"},
              {"lga": "Litchfield", "region": "Darwin"},
              {"lga": "Belyuen", "region": "Darwin"},
              {"lga": "Coomalie", "region": "Darwin"},
              {"lga": "Wagait", "region": "Darwin"},
              {"lga": "Tiwi Islands", "region": "Darwin"},
              {"lga": "West Arnhem", "region": "Arnhem"},
              {"lga": "East Arnhem", "region": "Arnhem"},
              {"lga": "Groote Archipelago", "region": "Arnhem"},
              {"lga": "Katherine", "region": "Katherine"},
              {"lga": "Victoria Daly", "region": "Katherine"},
              {"lga": "West Daly", "region": "Katherine"},
              {"lga": "Roper Gulf", "region": "Katherine"},
              {"lga": "Barkly", "region": "Barkly/Tennant Creek"},
              {"lga": "Alice Springs", "region": "Alice Springs & Central Australia"},
              {"lga": "MacDonnell", "region": "Alice Springs & Central Australia"},
              {"lga": "Central Desert", "region": "Alice Springs & Central Australia"}
            ]},
            "key": "lga",
            "fields": ["region"]
          },
          "default": "Unincorporated land"
        }
      ],
  "mark": {"type": "geoshape", "stroke": "#9aa394", "strokeWidth": 0.8},
  "encoding": {
    "color": {
      "condition": {"test": "datum.region == null", "value": "#c9ccc4"},
      "field": "region", "type": "nominal", "title": "Region",
      "scale": {
        "domain": ["Darwin", "Arnhem", "Katherine", "Barkly/Tennant Creek", "Alice Springs & Central Australia", "Unincorporated land"],
        "range": ["#d9e6f0", "#f2e6c9", "#efd9dd", "#e2dcef", "#f0dcc4","#e3e6e1"]
      },
      "legend": {"orient": "right", "title": "Region", "titleFontSize": 14, "labelFontSize": 12}
    },
    "tooltip": [
      {"field": "properties.LGA_NAME23", "type": "nominal", "title": "LGA"},
      {"field": "region", "type": "nominal", "title": "Region"}
    ]
  }
  }, 
    {
      "data": {"url": "https://yewsze.github.io/Data-Visualisation-2/data/finalized/top_NT_parks.csv"},
      "mark": {"type": "circle", "color": "#6aab6d", "opacity": 0.5, "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "visitors", "type": "quantitative", "title": "Visitors",
          "scale": {"domain": [0, 1500000], "range": [0, 3500]},
          "legend": {"orient": "right", "format": ",.0f", "titleFontSize": 14, "labelFontSize": 12}
        },
        "order": {"field": "visitors", "type": "quantitative", "sort": "descending"},
        "tooltip": [
          {"field": "parks", "title": "Park"},
          {"field": "visitors", "title": "Visitors", "format": ","}
        ]
      }
    },
    {
      "data": {"url": "https://yewsze.github.io/Data-Visualisation-2/data/finalized/top_NT_parks.csv"},
      "mark": {"type": "text", "align": "left", "dx": 9, "fontSize": 9, "color": "#333",
               "opacity": {"expr": "zoom_level > 12000 ? 1 : 0"}},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "parks", "type": "nominal"}
      }
    }
  ]
}