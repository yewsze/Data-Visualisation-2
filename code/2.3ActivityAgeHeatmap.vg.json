{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Participation in Outdoor Recreational Activities by Age Group",
    "anchor": "start"
  },
  "width": {"step": 120},
  "height": {"step": 60},
  "data": {"url": "https://yewsze.github.io/Data-Visualisation-2/data/finalized/2.2ActivityByAge.csv"},

"transform": [
  {"calculate": "datum['\ufeffactivity'] || datum['activity']", "as": "activity_clean"},
  {
    "calculate": "format(datum['participation rate'], '.1f') + '%'",
    "as": "formatted_rate"
  }
],
"encoding": {
  "y": {"field": "activity_clean", "type": "nominal", "title": null, "axis": {"labelFontSize": 12, "titleFontSize": 14,"labelPadding": 6}},
    "x": {
      "field": "age group",
      "type": "ordinal",
      "title": "Age group",
      "sort": ["15-17", "18-24", "25-34", "35-44", "45-54", "55-64", "64+"],
      "axis": {"labelAngle": 0, "labelFontSize": 12, "titleFontSize": 14, "labelPadding": 10}
    }
  },
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "color": {
          "field": "participation rate",
          "type": "quantitative",
          "title": "Participation Rate (%)",
          "scale": {"type": "sqrt", "scheme": "purples"},
          "legend": {
            "labelExpr": "format(datum.value, '.0f') + '%'",
            "direction": "vertical", 
            "gradientLength": 120, 
            "labelFontSize": 12, 
            "titleFontSize": 12}
        }
      }
    },
    {
      "mark":  {
            "type": "text",
            "fontSize": 12
          },
      "encoding": {
        "text": {"field": "formatted_rate", "type": "nominal"},
        "color": {
          "condition": {"test": "datum['participation rate'] < 2", "value": "black"},
          "value": "white"
        }
      }
    }
  ],
  "config": {
    "axis": {"grid": false, "domain": false, "ticks": false}
  }
}