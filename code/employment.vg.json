{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mosaic plot: employment status of active adults at three activity frequencies, Jan-Dec 2025 (AusPlay National data tables, 30 April 2026, Table 32). Column width = number of active adults; segment height = share of those adults.",
  "width": 640,
  "height": 340,
  "padding": {
    "top": 10,
    "left": 10,
    "right": 10,
    "bottom": 10
  },
  "title": {
    "text": "Nearly Half of Active Adults Work Full-Time",
    "subtitle": "Employment status of active adults, Jan-Dec 2025. Column width = number of active adults.",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#555555",
    "offset": 12
  },
  "data": {
    "url": "https://yewsze.github.io/Data-Visualisation-2/data/finalized/employment.csv",
    "format": {
      "type": "csv",
      "parse": {
        "x0": "number",
        "x1": "number",
        "y0": "number",
        "y1": "number",
        "share": "number",
        "adults": "number",
        "level_total": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "(+datum.x0 + +datum.x1) / 2",
      "as": "xmid"
    },
    {
      "calculate": "(+datum.y0 + +datum.y1) / 2",
      "as": "ymid"
    },
    {
      "calculate": "+datum.y1 - +datum.y0",
      "as": "pct"
    }
  ],
  "layer": [
    {
      "description": "Mosaic tiles",
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": {
            "title": "Activeness of participation",
            "labels": false,
            "ticks": false,
            "domain": false,
            "grid": false,
            "titlePadding": 52
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "title": "Share of active adults",
          "axis": {
            "format": "%",
            "tickCount": 5,
            "grid": false,
            "domain": false,
            "labelFontSize": 11
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Employed full-time",
            "Employed part-time",
            "Employed casual",
            "Full-time student",
            "Home duties",
            "Retired or on a pension",
            "Unemployed"
          ],
          "scale": {
            "domain": [
              "Employed full-time",
              "Employed part-time",
              "Employed casual",
              "Full-time student",
              "Home duties",
              "Retired or on a pension",
              "Unemployed"
            ],
            "range": [
              "#1F5E48",
              "#2A7F62",
              "#6FB394",
              "#B7DCCB",
              "#E8C27A",
              "#C0562B",
              "#7A4A3A"
            ]
          },
          "legend": {
            "title": "Employment status",
            "orient": "right",
            "symbolType": "square",
            "labelFontSize": 12,
            "titleFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "level",
            "type": "nominal",
            "title": "Active"
          },
          {
            "field": "group",
            "type": "nominal",
            "title": "Employment status"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of active adults",
            "format": ".1%"
          },
          {
            "field": "adults",
            "type": "quantitative",
            "title": "Adults (est.)",
            "format": ","
          }
        ]
      }
    },
    {
      "description": "Percentage labels inside segments",
      "transform": [
        {
          "filter": "datum.pct >= 0.027"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "xmid",
          "type": "quantitative"
        },
        "y": {
          "field": "ymid",
          "type": "quantitative"
        },
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".1%"
        },
        "color": {
          "condition": {
            "test": "datum.group === 'Employed full-time' || datum.group === 'Employed part-time' || datum.group === 'Retired or on a pension' || datum.group === 'Unemployed'",
            "value": "#FFFFFF"
          },
          "value": "#1F3D33"
        }
      }
    },
    {
      "description": "Column labels below the chart: activity level (one per column)",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "x1",
              "as": "cx1"
            },
            {
              "op": "max",
              "field": "level",
              "as": "lv"
            },
            {
              "op": "sum",
              "field": "adults",
              "as": "tot"
            }
          ],
          "groupby": [
            "x0"
          ]
        },
        {
          "calculate": "(+datum.x0 + +datum.cx1) / 2",
          "as": "xm"
        },
        {
          "calculate": "datum.tot > 0 ? format(datum.tot / 1000000, '.1f') + 'M active adults' : ''",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "dy": 8,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "datum": 0,
          "type": "quantitative"
        },
        "text": {
          "field": "lv",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Column labels below the chart: number of active adults",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "x1",
              "as": "cx1"
            },
            {
              "op": "max",
              "field": "level",
              "as": "lv"
            },
            {
              "op": "sum",
              "field": "adults",
              "as": "tot"
            }
          ],
          "groupby": [
            "x0"
          ]
        },
        {
          "calculate": "(+datum.x0 + +datum.cx1) / 2",
          "as": "xm"
        },
        {
          "calculate": "datum.tot > 0 ? format(datum.tot / 1000000, '.1f') + 'M active adults' : ''",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "dy": 26,
        "fontSize": 12,
        "color": "#666666"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "datum": 0,
          "type": "quantitative"
        },
        "text": {
          "field": "note",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}