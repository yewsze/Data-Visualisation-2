{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 20 activities by participation",
    "subtitle": "Share of adults (15+) who took part in the past year, 2025",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 12
  },
  "width": 520,
  "height": {"step": 26},
  "autosize": {"type": "pad", "resize": true},
  "padding": {"left": 10, "right": 20, "top": 10, "bottom": 10},
  "data": {"url": "../data/finalized/1.2ActivityRank.csv"},
  "params": [
    {
      "name": "activitySettingFilter",
      "value": [
        "Select All",
        "Core outdoor",
        "Outdoor-capable",
        "Indoor/facility-based"
      ],
      "bind": {
        "input": "select",
        "options": [
          "Select All",
          "Core outdoor",
          "Outdoor-capable",
          "Indoor/facility-based"
        ],
        "multiple": true,
        "name": "Filter by setting: "
      }
    }
  ],
  "transform": [
    {
      "filter": "indexof(activitySettingFilter, 'Select All') >= 0 || indexof(activitySettingFilter, datum.setting) >= 0"
    },
    {
      "window": [{"op": "row_number", "as": "rank"}],
      "sort": [{"field": "rate", "order": "descending"}]
    },
    {"filter": "datum.rank <= 20"}
  ],
  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "title": null,
      "sort": {"field": "rank", "op": "min", "order": "ascending"},
      "axis": {"labelLimit": 220, "labelFontSize": 12}
    },
    "x": {
      "field": "rate",
      "type": "quantitative",
      "title": "Share of adults",
      "axis": {"format": "%"},
      "scale": {"domain": [0, 0.75]}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "tooltip": true},
      "encoding": {
        "color": {
          "field": "setting",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Core outdoor",
              "Outdoor-capable",
              "Indoor/facility-based"
            ],
            "range": ["#2e7d5b", "#e9b44c", "#6c7a89"]
          },
          "legend": {"orient": "bottom", "title": "Setting"}
        },
        "tooltip": [
          {"field": "rank", "title": "Rank in selection"},
          {"field": "overall_rank", "title": "Overall rank (of 142)"},
          {"field": "activity", "title": "Activity"},
          {"field": "setting", "title": "Setting"},
          {"field": "rate", "title": "Share of adults", "format": ".1%"},
          {"field": "adults", "title": "Estimated adults", "format": ",.0f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "color": "#333"
      },
      "encoding": {"text": {"field": "label", "type": "nominal"}}
    }
  ],
  "config": {"view": {"stroke": null}}
}