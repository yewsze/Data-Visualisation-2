{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": {"step": 65},
  "height": {"step": 35},
  "data": {"url": "../data/finalized/2.2ActivityByAge.csv"},

"transform": [
  {"calculate": "datum['\ufeffactivity'] || datum['activity']", "as": "activity_clean"},
  {
    "calculate": "format(datum['participation rate'], '.1f') + '%'",
    "as": "formatted_rate"
  }
],
"encoding": {
  "y": {"field": "activity_clean", "type": "nominal", "title": null},
    "x": {
      "field": "age group",
      "type": "ordinal",
      "title": "Age group",
      "sort": ["15-17", "18-24", "25-34", "35-44", "45-54", "55-64", "64+"],
      "axis": {"labelAngle": 0}
    }
  },
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "color": {
          "field": "participation rate",
          "type": "quantitative",
          "title": "Participation Rate (%)",
          "scale": {"type": "sqrt", "scheme": "blues"},
          "legend": {"direction": "horizontal", "gradientLength": 120}
        }
      }
    },
    {
      "mark": "text",
      "encoding": {
        "text": {"field": "formatted_rate", "type": "nominal"},
        "color": {
          "condition": {"test": "datum['participation rate'] < 4", "value": "black"},
          "value": "white"
        }
      }
    }
  ],
  "config": {
    "axis": {"grid": false, "domain": false, "ticks": false}
  }
}