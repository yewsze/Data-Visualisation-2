{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Population pyramid of adults who are active at least once a year",
    "anchor": "start",
    "fontSize": 18,
    "offset": 14
  },
  "data": {
    "url": "https://yewsze.github.io/Data-Visualisation-2/data/finalized/PopulationPyramid.csv",
    "format": {"type": "csv", "parse": {"rate": "number", "adults": "number"}}
  },
  "spacing": 0,
  "hconcat": [
    {
      "title": {"text": "Males", "anchor": "middle", "fontSize": 14, "fontWeight": "bold", "color": "#7eaacb", "offset": 6},
      "width": 300,
      "height": {"step": 38},
      "transform": [{"filter": "datum.gender === 'Male'"}],
      "encoding": {
        "y": {"field": "age_group", "type": "nominal", "sort": "descending", "axis": null},
        "x": {
          "field": "rate", "type": "quantitative",
          "scale": {"domain": [0, 1], "reverse": true},
          "axis": {
            "format": "%", "values": [0, 0.25, 0.5, 0.75, 1], "grid": true,
            "title": "% of males who took part", "labelFontSize": 12, "titleFontSize": 14
          }
        }
      },
      "layer": [
        {
          "mark": {"type": "bar", "color": "#7eaacb", "stroke": "white", "strokeWidth": 1},
          "encoding": {
            "tooltip": [
              {"field": "age_group", "type": "nominal", "title": "Age group"},
              {"field": "rate", "type": "quantitative", "title": "Took part at least once a year", "format": ".1%"},
              {"field": "adults", "type": "quantitative", "title": "Estimated adults", "format": "~s"}
            ]
          }
        },
        {
          "mark": {"type": "text", "color": "white", "fontWeight": "bold", "fontSize": 11, "align": "left", "dx": 6},
          "encoding": {
            "text": {"field": "rate", "type": "quantitative", "format": ".1%"}
          }
        }
      ]
    },
    {
      "title": {"text": "Age", "anchor": "middle", "fontSize": 14, "color": "#555", "offset": 6},
      "width": 50,
      "height": {"step": 38},
      "transform": [{"filter": "datum.gender === 'Male'"}],
      "mark": {"type": "text", "fontSize": 14, "color": "#333", "align": "center"},
      "encoding": {
        "y": {"field": "age_group", "type": "nominal", "sort": "descending", "axis": null},
        "text": {"field": "age_group", "type": "nominal"}
      }
    },
    {
      "title": {"text": "Females", "anchor": "middle", "fontSize": 14, "fontWeight": "bold", "color": "#cb77a0", "offset": 6},
      "width": 350,
      "height": {"step": 38},
      "transform": [{"filter": "datum.gender === 'Female'"}],
      "encoding": {
        "y": {"field": "age_group", "type": "nominal", "sort": "descending", "axis": null},
        "x": {
          "field": "rate", "type": "quantitative",
          "scale": {"domain": [0, 1], "reverse": false},
          "axis": {
            "format": "%", "values": [0, 0.25, 0.5, 0.75, 1], "grid": true,
            "title": "% of females who took part", "labelFontSize": 12, "titleFontSize": 14
          }
        }
      },
      "layer": [
        {
          "mark": {"type": "bar", "color": "#cb77a0", "stroke": "white", "strokeWidth": 1},
          "encoding": {
            "tooltip": [
              {"field": "age_group", "type": "nominal", "title": "Age group"},
              {"field": "rate", "type": "quantitative", "title": "Took part at least once a year", "format": ".1%"},
              {"field": "adults", "type": "quantitative", "title": "Estimated adults", "format": "~s"}
            ]
          }
        },
        {
          "mark": {"type": "text", "color": "white", "fontWeight": "bold", "fontSize": 11, "align": "right", "dx": -6},
          "encoding": {
            "text": {"field": "rate", "type": "quantitative", "format": ".1%"}
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Inter, Helvetica, Arial, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelColor": "#333", "titleColor": "#555", "titleFontWeight": "normal"}
  }
}