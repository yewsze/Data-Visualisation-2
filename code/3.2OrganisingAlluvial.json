{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Alluvial: age group -> informal/organised -> way of taking part (AusPlay National Table 4, Jan-Dec 2025, adults, all genders). Layout computed in Vega.",
  "width": "container",
  "height": 600,
  "padding": {
    "left": 10,
    "right": 100,
    "top": 100,
    "bottom": 20
  },
  "autosize": "none",
  "signals": [
    {
      "name": "chartH",
      "value": 600
    },
    {
      "name": "nodeGap",
      "value": 8
    },
    {
      "name": "ageW",
      "value": 64
    },
    {
      "name": "groupW",
      "value": 150
    },
    {
      "name": "wayW",
      "value": 280
    },
    {
      "name": "minH",
      "value": 10
    },
    {
      "name": "xAge",
      "value": 0
    },
    {
      "name": "xGroup",
      "value": 300
    },
    {
      "name": "xWay",
      "value": 620
    },
    {
      "name": "totalAll",
      "update": "length(data('totals')) ? data('totals')[0].total : 1"
    },
    {
      "name": "nWays",
      "update": "length(data('wayList'))"
    },
    {
      "name": "pxPer",
      "update": "(chartH - nodeGap*(max(7, nWays)-1)) / totalAll"
    },
    {
      "name": "hoverAge",
      "value": null,
      "on": [
        {
          "events": "@ageNode:mouseover, @link1:mouseover, @link2:mouseover",
          "update": "datum.age"
        },
        {
          "events": "@ageNode:mouseout, @link1:mouseout, @link2:mouseout",
          "update": "null"
        }
      ]
    },
    {
      "name": "hoverWay",
      "value": null,
      "on": [
        {
          "events": "@wayNode:mouseover",
          "update": "datum.way"
        },
        {
          "events": "@wayNode:mouseout",
          "update": "null"
        }
      ]
    }
  ],
