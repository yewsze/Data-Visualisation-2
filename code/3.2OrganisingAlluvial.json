    {
      "name": "rawF",
      "source": "raw",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.group !== 'Other'"
        }
      ]
    },
    {
      "name": "totals",
      "source": "rawF",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "sum"
          ],
          "fields": [
            "participants"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "wayList",
      "source": "rawF",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "way"
          ]
        }
      ]
    },
    {
      "name": "ageNodes",
      "source": "rawF",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "age",
            "aidx"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "participants"
          ],
          "as": [
            "value"
          ]
        },
        {
          "type": "window",
          "sort": {
            "field": "aidx"
          },
          "ops": [
            "row_number",
            "sum"
          ],
          "fields": [
            null,
            "value"
          ],
          "as": [
            "rank",
            "cum"
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "type": "formula",
          "as": "y1u",
          "expr": "datum.cum*pxPer + (datum.rank-1)*nodeGap"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "y1u"
          ],
          "ops": [
            "max"
          ],
          "as": [
            "colH"
          ]
        },
        {
          "type": "formula",
          "as": "y0",
          "expr": "datum.y1u - datum.value*pxPer + (chartH - datum.colH)/2"
        },
        {
          "type": "formula",
          "as": "y1",
          "expr": "datum.y0 + datum.value*pxPer"
        }
      ]
    },
    {
      "name": "groupNodes",
      "source": "rawF",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "group",
            "gidx"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "participants"
          ],
          "as": [
            "value"
          ]
        },
        {
          "type": "window",
          "sort": {
            "field": "gidx"
          },
          "ops": [
            "row_number",
            "sum"
          ],
          "fields": [
            null,
            "value"
          ],
          "as": [
            "rank",
            "cum"
          ],
