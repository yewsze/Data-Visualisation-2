{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Sports clubs organise most team and court activity;",
      "private businesses run studio fitness and dance"
    ],
    "subtitle": [
      "Mix of organising entity types for the top 20 activities (adults 15+, 2025). People can use more than one entity.",
      "Only six entity types are reported - events, community groups and social groups are not.  * = the six cover under 70% of organised participation."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11
  },
  "width": 480,
  "height": {
    "step": 26
  },
  "data": {
    "url": "../data/finalized/2.1OrganisingEntity.csv"
  },
  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "rank",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "labelLimit": 220,
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative",
          "stack": "zero",
          "title": "Share of the six listed organising entity types",
          "axis": {
            "format": "%",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ]
          },
          "scale": {
            "domain": [
              0,
              1.55
            ]
          }
        },
        "color": {
          "field": "entity",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Sports club",
              "Recreation club",
              "Gym / fitness / leisure centre",
              "Private business",
              "Personal trainer / coach",
              "Educational institution"
            ],
            "range": [
              "#1b6ca8",
              "#4cb5ae",
              "#e9b44c",
              "#c8553d",
              "#7a6c9e",
              "#8d99ae"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 3,
            "symbolType": "square"
          }
        },
        "order": {
          "field": "entity_order",
          "type": "quantitative",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "activity",
            "title": "Activity"
          },
          {
            "field": "entity",
            "title": "Organising entity"
          },
          {
            "field": "adults",
            "title": "Adults using this entity",
            "format": ",.0f"
          },
          {
            "field": "share",
            "title": "Share of the six types",
            "format": ".0%"
          },
          {
            "field": "total_organised",
            "title": "All organised adults",
            "format": ",.0f"
          },
          {
            "field": "coverage",
            "title": "Six types / all organised",
            "format": ".0%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.entity == 'Sports club'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "color": "#333"
      },
      "encoding": {
        "x": {
          "datum": 1,
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "transform": [
    {
      "calculate": "indexof([\"Sports club\", \"Recreation club\", \"Gym / fitness / leisure centre\", \"Private business\", \"Personal trainer / coach\", \"Educational institution\"], datum.entity)",
      "as": "entity_order"
    }
  ]
}