{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart: rank of the places adults were active, by age group, Jan-Dec 2025 (AusPlay National data tables, 30 April 2026, Table 7). Circles show the share of adults who were active at each place.",
  "width": "container",
  "height": 400,
  "padding": {
    "top": 10,
    "left": 30,
    "right": 30,
    "bottom": 20
  },
  "data": {
    "url": "https://yewsze.github.io/Data-Visualisation-2/data/finalized/place.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rate": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "rate",
          "order": "descending"
        }
      ],
      "groupby": [
        "age_group"
      ]
    },
    {
      "calculate": "datum.place === 'Public space' ? 'Public space' : 'Other places'",
      "as": "highlight"
    }
  ],
  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "sort": [
        "15-17",
        "18-24",
        "25-34",
        "35-44",
        "45-54",
        "55-64",
        "65+"
      ],
      "title": "Age group",
      "scale": {
        "padding": 0.5
      },
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "titleFontSize": 12,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "scale": {
        "domain": [
          9.6,
          0.4
        ]
      },
      "axis": null
    }
  },
  "layer": [
    {
      "description": "Lines for the other places (one grey)",
      "transform": [
        {
          "filter": "datum.highlight === 'Other places'"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#bac1bd",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "place",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Line for Public space (green, drawn on top)",
      "transform": [
        {
          "filter": "datum.highlight === 'Public space'"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#d5b283",
        "strokeWidth": 6
      },
      "encoding": {
        "detail": {
          "field": "place",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Circles for the other places",
      "transform": [
        {
          "filter": "datum.highlight === 'Other places'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#aeb2b0",
        "size": 1800,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "place",
            "type": "nominal",
            "title": "Place"
          },
          {
            "field": "age_group",
            "type": "ordinal",
            "title": "Age group"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Adults active here",
            "format": ".1%"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank"
          }
        ]
      }
    },
    {
      "description": "Circles for Public space",
      "transform": [
        {
          "filter": "datum.highlight === 'Public space'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#d5b283",
        "size": 1800,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "place",
            "type": "nominal",
            "title": "Place"
          },
          {
            "field": "age_group",
            "type": "ordinal",
            "title": "Age group"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Adults active here",
            "format": ".1%"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank"
          }
        ]
      }
    },
    {
      "description": "Percentage inside each circle",
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#FFFFFF"
      },
      "encoding": {
        "text": {
          "field": "rate",
          "type": "quantitative",
          "format": ".1%"
        }
      }
    },
    {
      "description": "Place names on the left (youngest group)",
      "transform": [
        {
          "filter": "datum.age_group === '15-17'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -26,
        "fontSize": 12,
        "color": "#555555"
      },
      "encoding": {
        "text": {
          "field": "place",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.highlight === 'Public space'",
            "value": "#764616"
          },
          "value": "#555555"
        }
      }
    },
    {
      "description": "Place names on the right (oldest group)",
      "transform": [
        {
          "filter": "datum.age_group === '65+'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 26,
        "dy": 4,
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "place",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.highlight === 'Public space'",
            "value": "#764616"
          },
          "value": "#555555"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}