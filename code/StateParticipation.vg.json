                { "calculate": "-43.8", "as": "outside_lat" },
                { "calculate": "datum.state + ' ' + format(datum.rate, '.0%')", "as": "outside_label" }
              ],
              "mark": { "type": "text", "align": "left", "fontSize": 9, "fontWeight": "bold", "dx": 3 },
              "encoding": {
                "longitude": { "field": "outside_lon", "type": "quantitative" },
                "latitude": { "field": "outside_lat", "type": "quantitative" },
                "text": { "field": "outside_label" },
                "color": { "value": "#1a1a1a" }
              }
            }
          ]
        },
        {
          "title": { "text": "ACT", "anchor": "start", "fontSize": 10, "offset": 2 },
          "transform": [
            { "filter": "datum.state === 'ACT'" },
            { "calculate": "datum.state + ' ' + format(datum.rate, '.0%')", "as": "lbl" }
