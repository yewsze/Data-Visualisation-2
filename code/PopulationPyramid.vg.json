{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Population-pyramid style chart: share of Australian men and women in each age group who took part in sport or physical activity at least once a year, AusPlay Jan-Dec 2025.",
  "title": {
    "text": "Nearly nine in ten adults are active up to age 64, then participation drops at 65+",
    "subtitle": [
      "Share of men (left) and women (right) in each age group who did any sport or physical activity at least once in the past 12 months, Jan-Dec 2025.",
        "Source: AusPlay Table 15, Jan-Dec 2025. Excludes children (0-14)."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#555",
    "subtitlePadding": 6,
    "offset": 14
  },
  "data": {
    "url": "../data/finalized/PopulationPyramid.csv",
    "format": {
      "type": "csv"
    }
  },
  "spacing": 6,
  "hconcat": [
    {
      "title": {
        "text": "Males",
        "anchor": "middle",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#2a7f8f",
        "offset": 6
      },
      "width": 250,
      "height": {
        "step": 38
      },
      "transform": [
        {
          "filter": "datum.gender === 'Male'"
        },
        {
          "calculate": "toNumber(datum.rate)",
          "as": "rate_n"
        },
        {
          "calculate": "toNumber(datum.adults)",
          "as": "adults_n"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#2a7f8f",
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "y": {
              "field": "age_group",
              "type": "nominal",
              "sort": [
                "65+",
                "55-64",
                "45-54",
                "35-44",
                "25-34",
                "18-24",
                "15-17"
              ],
              "axis": null
            },
            "x": {
              "field": "rate_n",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ],
                "reverse": true
              },
              "axis": {
                "format": "%",
                "values": [
                  0,
                  0.25,
                  0.5,
                  0.75,
                  1
                ],
                "grid": false,
                "title": "% of males who took part at least once a year",
                "titleFontSize": 11
              }
            },
            "tooltip": [
              {
                "field": "age_group",
                "type": "nominal",
                "title": "Age group"
              },
              {
                "field": "rate_n",
                "type": "quantitative",
                "title": "Took part at least once a year",
                "format": ".1%"
              },
              {
                "field": "adults_n",
                "type": "quantitative",
                "title": "Estimated adults",
                "format": "~s"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "color": "white",
            "fontWeight": "bold",
            "fontSize": 11,
            "align": "left",
            "dx": 6
          },
          "encoding": {
            "y": {
              "field": "age_group",
              "type": "nominal",
              "sort": [
                "65+",
                "55-64",
                "45-54",
                "35-44",
                "25-34",
                "18-24",
                "15-17"
              ]
            },
            "x": {
              "field": "rate_n",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ],
                "reverse": true
              }
            },
            "text": {
              "field": "rate_n",
              "type": "quantitative",
              "format": ".1%"
            }
          }
        }
      ]
    },
    {
      "width": 50,
      "height": {
        "step": 38
      },
      "title": {
        "text": "Age",
        "anchor": "middle",
        "fontSize": 12,
        "color": "#555",
        "offset": 6
      },
      "transform": [
        {
          "filter": "datum.gender === 'Male'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#333",
        "align": "center"
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": [
            "65+",
            "55-64",
            "45-54",
            "35-44",
            "25-34",
            "18-24",
            "15-17"
          ],
          "axis": null
        },
        "text": {
          "field": "age_group",
          "type": "nominal"
        }
      }
    },
    {
      "title": {
        "text": "Females",
        "anchor": "middle",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#b5457b",
        "offset": 6
      },
      "width": 250,
      "height": {
        "step": 38
      },
      "transform": [
        {
          "filter": "datum.gender === 'Female'"
        },
        {
          "calculate": "toNumber(datum.rate)",
          "as": "rate_n"
        },
        {
          "calculate": "toNumber(datum.adults)",
          "as": "adults_n"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#b5457b",
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "y": {
              "field": "age_group",
              "type": "nominal",
              "sort": [
                "65+",
                "55-64",
                "45-54",
                "35-44",
                "25-34",
                "18-24",
                "15-17"
              ],
              "axis": null
            },
            "x": {
              "field": "rate_n",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ],
                "reverse": false
              },
              "axis": {
                "format": "%",
                "values": [
                  0,
                  0.25,
                  0.5,
                  0.75,
                  1
                ],
                "grid": false,
                "title": "% of females who took part at least once a year",
                "titleFontSize": 11
              }
            },
            "tooltip": [
              {
                "field": "age_group",
                "type": "nominal",
                "title": "Age group"
              },
              {
                "field": "rate_n",
                "type": "quantitative",
                "title": "Took part at least once a year",
                "format": ".1%"
              },
              {
                "field": "adults_n",
                "type": "quantitative",
                "title": "Estimated adults",
                "format": "~s"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "color": "white",
            "fontWeight": "bold",
            "fontSize": 11,
            "align": "right",
            "dx": -6
          },
          "encoding": {
            "y": {
              "field": "age_group",
              "type": "nominal",
              "sort": [
                "65+",
                "55-64",
                "45-54",
                "35-44",
                "25-34",
                "18-24",
                "15-17"
              ]
            },
            "x": {
              "field": "rate_n",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ],
                "reverse": false
              }
            },
            "text": {
              "field": "rate_n",
              "type": "quantitative",
              "format": ".1%"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Inter, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#333",
      "titleColor": "#555",
      "titleFontWeight": "normal"
    }
  }
}