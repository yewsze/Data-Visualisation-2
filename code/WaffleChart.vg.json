{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: share of Australian adults by how often they took part in sport or physical activity, AusPlay Table 9, Jan-Dec 2025. Each square is 1% of adults.",
  "title": {
    "text": "6 in 7 Australian adults were active in the past year",
    "subtitle": [
      "Each square is 1% of adults (about 226,000 people). Weekly or more: 69%  |  Less than weekly: 17%  |  Did not take part: 14%.",
      "\"Active\" means taking part in at least one sport or physical activity in the past 12 months, Jan-Dec 2025."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#555",
    "subtitlePadding": 6,
    "offset": 14
  },
  "width": 320,
  "height": 320,
  "data": {
    "url": "../data/finalized/WaffleChart.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.squares)",
      "as": "sq"
    },
    {
      "calculate": "toNumber(datum.tier_order)",
      "as": "ord"
    },
    {
      "calculate": "toNumber(datum.rate)",
      "as": "rate_n"
    },
    {
      "calculate": "toNumber(datum.adults)",
      "as": "adults_n"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "sq",
          "as": "sq_end"
        }
      ],
      "sort": [
        {
          "field": "ord"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.sq_end - datum.sq",
      "as": "sq_start"
    },
    {
      "calculate": "sequence(datum.sq_start, datum.sq_end)",
      "as": "idx"
    },
    {
      "flatten": [
        "idx"
      ]
    },
    {
      "calculate": "datum.idx % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.idx / 10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.12,
        "paddingOuter": 0
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending",
      "scale": {
        "paddingInner": 0.12,
        "paddingOuter": 0
      }
    },
    "color": {
      "field": "tier",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Weekly or more",
          "Less than weekly",
          "Did not take part"
        ],
        "range": [
          "#1f7a4d",
          "#8bc79b",
          "#d4d4d4"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "symbolType": "square",
        "labelFontSize": 12
      }
    },
    "tooltip": [
      {
        "field": "tier",
        "type": "nominal",
        "title": "How often"
      },
      {
        "field": "rate_n",
        "type": "quantitative",
        "title": "Share of adults",
        "format": ".1%"
      },
      {
        "field": "adults_n",
        "type": "quantitative",
        "title": "Estimated adults",
        "format": "~s"
      }
    ]
  },
  "config": {
    "font": "Inter, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    }
  }
}