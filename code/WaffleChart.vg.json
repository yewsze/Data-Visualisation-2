{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 320,
  "data": {
    "url": "../data/finalized/WaffleChart.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.squares)",
      "as": "sq"
    },
    {
      "calculate": "toNumber(datum.tier_order)",
      "as": "ord"
    },
    {
      "calculate": "toNumber(datum.rate)",
      "as": "rate_n"
    },
    {
      "calculate": "toNumber(datum.adults)",
      "as": "adults_n"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "sq",
          "as": "sq_end"
        }
      ],
      "sort": [
        {
          "field": "ord"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.sq_end - datum.sq",
      "as": "sq_start"
    },
    {
      "calculate": "sequence(datum.sq_start, datum.sq_end)",
      "as": "idx"
    },
    {
      "flatten": [
        "idx"
      ]
    },
    {
      "calculate": "datum.idx % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.idx / 10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.12,
        "paddingOuter": 0
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending",
      "scale": {
        "paddingInner": 0.12,
        "paddingOuter": 0
      }
    },
    "color": {
      "field": "tier",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Weekly or more",
          "Less than weekly",
          "Did not take part"
        ],
        "range": [
          "#1f7a4d",
          "#8bc79b",
          "#d4d4d4"
        ]
      },
      "legend": {
        "orient": "right",
        "direction": "vertical",
        "symbolType": "square",
        "labelFontSize": 14
      }
    },
    "tooltip": [
      {
        "field": "tier",
        "type": "nominal",
        "title": "How often"
      },
      {
        "field": "rate_n",
        "type": "quantitative",
        "title": "Share of adults",
        "format": ".1%"
      },
      {
        "field": "adults_n",
        "type": "quantitative",
        "title": "Estimated adults",
        "format": "~s"
      }
    ]
  },
  "config": {
    "font": "Inter, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    }
  }
}