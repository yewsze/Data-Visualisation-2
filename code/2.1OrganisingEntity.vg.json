{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Structured Channels in Top 10 Outdoor Recreational Activities",
    "subtitle": "Comparing by Organised and Unorganised Participation, 2025",
    "anchor": "start"
  },

  "width": 550,
  "height": {"step": 40},

  "data": {
    "url": "https://yewsze.github.io/Data-Visualisation-2/data/finalized/2.1.UpdatedOrganisingEntity.csv"
  },

  "transform": [
    {
      "calculate": "datum['\ufeff\"activity\"'] || datum['\ufeffactivity'] || datum['activity']",
      "as": "activity_name"
    }
  ],

  "mark": {
    "type": "bar"
  },

  "encoding": {
    "y": {
      "field": "activity_name",
      "type": "nominal",
      "title": null,
      "axis": {"labelLimit": 220, "labelFontSize": 12}
    },
    "yOffset": {
      "field": "organisation_type"
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "Participation"
    },
    "color": {
      "field": "organisation_type",
      "type": "nominal",
      "scale": {
        "range": ["#2e7d5b", "#e9b44c"]
      },
      "legend": {
        "orient": "right",
        "direction": "vertical",
        "title": "Participation type",
        "labelFontSize": 14
      }
    },
    "tooltip": [
      {"field": "activity_name", "title": "Activity"},
      {"field": "organisation_type", "title": "Type"},
      {"field": "value", "title": "Participation", "format": ","}
    ]
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}