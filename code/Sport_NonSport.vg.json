{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "100% stacked bar: share of Australian adults by type of activity (sport / non-sport) across age groups, AusPlay Table 15, Jan-Dec 2025.",
  "title": {
    "text": "Sport gives way to non-sport activity as Australians get older",
    "subtitle": [
      "Share of all adults (15+) by the type of physical activity they did in the past 12 months, Jan-Dec 2025.",
      "Sport = e.g. team sports, running, swimming, cycling, golf. Non-sport = e.g. gym, bushwalking, recreational dance."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#555",
    "subtitlePadding": 6,
    "offset": 14
  },
  "width": 560,
  "height": {
    "step": 34
  },
  "data": {
    "url": "../data/finalized/Sport_NonSport.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.gender === 'All'"
    },
    {
      "calculate": "toNumber(datum.rate)",
      "as": "rate_n"
    },
    {
      "calculate": "toNumber(datum.adults)",
      "as": "adults_n"
    },
    {
      "calculate": "toNumber(datum.category_order)",
      "as": "order_n"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "title": null,
          "sort": [
            "All ages",
            "15-17",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65+"
          ],
          "axis": {
            "domain": false,
            "ticks": false,
            "labelPadding": 8,
            "labelFontSize": 12
          }
        },
        "x": {
          "field": "rate_n",
          "type": "quantitative",
          "aggregate": "sum",
          "stack": "normalize",
          "title": "Share of adults in each age group",
          "axis": {
            "format": "%",
            "grid": false,
            "tickCount": 5
          }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Sport only",
              "Both sport and non-sport",
              "Non-sport only",
              "Did not take part"
            ],
            "range": [
              "#2f5f98",
              "#7b5ea7",
              "#e8a33d",
              "#d9d9d9"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "labelFontSize": 12
          }
        },
        "order": {
          "field": "order_n",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "age_group",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Activity type"
          },
          {
            "field": "rate_n",
            "type": "quantitative",
            "aggregate": "sum",
            "title": "Share of adults",
            "format": ".1%"
          },
          {
            "field": "adults_n",
            "type": "quantitative",
            "aggregate": "sum",
            "title": "Estimated adults",
            "format": "~s"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "stack": "rate_n",
          "groupby": [
            "age_group"
          ],
          "sort": [
            {
              "field": "order_n",
              "order": "ascending"
            }
          ],
          "offset": "normalize",
          "as": [
            "seg_start",
            "seg_end"
          ]
        },
        {
          "calculate": "(datum.seg_start + datum.seg_end) / 2",
          "as": "seg_mid"
        },
        {
          "filter": "datum.rate_n >= 0.05"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": [
            "All ages",
            "15-17",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65+"
          ]
        },
        "x": {
          "field": "seg_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "text": {
          "field": "rate_n",
          "type": "quantitative",
          "format": ".0%"
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Sport only",
              "Both sport and non-sport",
              "Non-sport only",
              "Did not take part"
            ],
            "range": [
              "#ffffff",
              "#ffffff",
              "#222222",
              "#222222"
            ]
          }
        }
      }
    }
  ],
  "config": {
    "font": "Inter, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#333",
      "titleColor": "#333",
      "titleFontWeight": "normal"
    }
  },
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}