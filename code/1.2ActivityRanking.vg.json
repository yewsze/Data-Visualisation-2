{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Most popular activities among adults, ranked by participation, 2025",
    "anchor": "start",
    "font": "Vanio, serif",
    "subtitleFont": "Vanio, serif",
    "fontSize": 18,
    "subtitleFontSize": 14,
    "fontWeight": "bold"
  },
  "width": "container",
  "height": 600,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {"left": 10, "right": 10, "top": 10, "bottom": 10},
  "data": {"url": "https://yewsze.github.io/Data-Visualisation-2/data/finalized/1.2ActivityRank.csv"},
  "params": [
    {
      "name": "classificationFilter",
      "value": [
        "Select All",
        "core outdoor",
        "outdoor capable",
        "indoor/facility-based"
      ],
      "bind": {
        "input": "select",
        "options": [
          "Select All",
          "core outdoor",
          "outdoor capable",
          "indoor/facility-based"
        ],
        "multiple": true,
        "name": "Filter by classification: "
      }
    }
  ],
  "transform": [
    {
      "lookup": "activity",
      "from": {
        "data": {"url": "https://yewsze.github.io/Data-Visualisation-2/data/finalized/0.Classification.csv"},
        "key": "Activity",
        "fields": ["Category"]
      },
      "as": ["classification"]
    },
    {
      "filter": "indexof(classificationFilter, 'Select All') >= 0 || indexof(classificationFilter, datum.classification) >= 0"
    },
    {
      "window": [{"op": "row_number", "as": "rank"}],
      "sort": [{"field": "rate", "order": "descending"}]
    },
    {"filter": "datum.rank <= 20"}
  ],
  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "title": null,
      "sort": {"field": "rank", "op": "min", "order": "ascending"},
      "axis": {"labelLimit": 220, "labelFontSize": 12}
    },
    "x": {
      "field": "rate",
      "type": "quantitative",
      "title": "Share of adults",
      "axis": {
            "format": "%",
            "grid": false,
            "tickCount": 6,
            "labelFontSize": 12,
            "titleFontSize": 14
          },
      "scale": {"domain": [0, 0.60]}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "tooltip": true},
      "encoding": {
        "color": {
          "field": "classification",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "core outdoor",
              "outdoor capable",
              "indoor/facility-based"
            ],
            "range": ["#dfecb9", "#f3e1a0", "#d7c5a1"]
          },
          "legend": {
            "orient": "right",
            "offset": 40,
            "direction": "vertical",
            "title": "Classification",
            "labelFontSize": 14}
        },
        "tooltip": [
          {"field": "rank", "title": "Rank in selection"},
          {"field": "overall_rank", "title": "Overall rank (of 142)"},
          {"field": "activity", "title": "Activity"},
          {"field": "classification", "title": "Classification"},
          {"field": "rate", "title": "Share of adults", "format": ".1%"},
          {"field": "adults", "title": "Estimated adults", "format": ",.0f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "color": "#333"
      },
      "encoding": {"text": {"field": "label", "type": "nominal"}}
    }
  ],
  "config": {"view": {"stroke": null}}
}