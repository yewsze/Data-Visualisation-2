{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "height": {"step": 50},
  "data": {
    "url": "https://yewsze.github.io/Data-Visualisation-2/data/finalized/Sport_NonSport.csv",
    "format": {"type": "csv", "parse": {"rate": "number", "adults": "number", "category_order": "number"}}
  },
  "encoding": {
    "y": {
      "field": "age_group", "type": "nominal", "title": null, "sort": null,
      "axis": {"domain": false, "ticks": false, "labelPadding": 8, "labelFontSize": 16}
    },
    "x": {
      "field": "rate", "type": "quantitative", "stack": "normalize",
      "title": "Share of adults in each age group",
      "axis": {"format": "%", "grid": false, "tickCount": 10, "labelFontSize": 14, "titleFontSize": 16}
    },
    "order": {"field": "category_order"}
  },
  "layer": [
    {
      "mark": {"type": "bar", "stroke": "white"},
      "encoding": {
        "color": {
          "field": "category", "type": "nominal", "title": null,
          "scale": {
            "domain": ["Sport only", "Both sport and non-sport", "Non-sport only", "Did not take part"],
            "range": ["#9abad3", "#b6aad1", "#e8d8ad", "#d9d9d9"]
          },
          "legend": {"orient": "right", "symbolType": "square", "labelFontSize": 14}
        },
        "tooltip": [
          {"field": "age_group", "title": "Age group"},
          {"field": "category", "title": "Activity type"},
          {"field": "rate", "type": "quantitative", "title": "Share of adults", "format": ".1%"},
          {"field": "adults", "type": "quantitative", "title": "Estimated adults", "format": "~s"}
        ]
      }
    },
    {
      "transform": [
        {"calculate": "datum.rate >= 0.05 ? format(datum.rate, '.0%') : ''", "as": "label"}
      ],
      "mark": {"type": "text", "fontSize": 14, "fontWeight": "bold"},
      "encoding": {
        "x": {"field": "rate", "type": "quantitative", "stack": "normalize", "bandPosition": 0.5},
        "text": {"field": "label"},
        "color": {"condition": {"test": "datum.category_order <= 2", "value": "white"}, "value": "#222"}
      }
    }
  ],
  "config": {
    "font": "Inter, Helvetica, Arial, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelColor": "#333", "titleColor": "#333", "titleFontWeight": "normal"}
  }
}